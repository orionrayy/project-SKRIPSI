{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-skripsi.local/schemas/writing/revision-audit-report.schema.json",
  "title": "Academic Revision Audit Report",
  "type": "object",
  "required": ["schema_version", "language", "status", "human_semantic_review_required", "similarity_or_ai_detector_scoring", "original_sha256", "candidate_sha256", "missing_protected_spans", "added_protected_spans", "epistemic_marker_changes", "flags", "review_checklist", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "language": {"type": "string", "minLength": 2},
    "status": {"enum": ["REVIEW_REQUIRED", "STRUCTURAL_CHECKS_CLEAR_HUMAN_REVIEW_REQUIRED"]},
    "human_semantic_review_required": {"const": true},
    "similarity_or_ai_detector_scoring": {"const": "NOT_PERFORMED"},
    "original_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "original_characters": {"type": "integer", "minimum": 1},
    "candidate_characters": {"type": "integer", "minimum": 1},
    "length_ratio": {"type": "number", "exclusiveMinimum": 0},
    "protected_span_count_original": {"type": "integer", "minimum": 0},
    "protected_span_count_candidate": {"type": "integer", "minimum": 0},
    "missing_protected_spans": {"type": "array"},
    "added_protected_spans": {"type": "array"},
    "epistemic_marker_changes": {"type": "array"},
    "flags": {"type": "array", "items": {"type": "string"}},
    "review_checklist": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
