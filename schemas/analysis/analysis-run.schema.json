{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-skripsi/schemas/analysis/analysis-run.schema.json",
  "title": "Reproducible Analysis Run Record",
  "type": "object",
  "required": [
    "analysis_run_id",
    "project_id",
    "run_at",
    "analysis_method",
    "software",
    "input_artifact_hashes",
    "script_or_command",
    "outputs",
    "review_status",
    "dataset_artifact_record_sha256",
    "decision_register_path",
    "decision_register_sha256",
    "phase_ledger_path",
    "phase_ledger_sha256",
    "analysis_specification_path",
    "analysis_specification_sha256",
    "dataset_artifact_path",
    "dataset_path",
    "dataset_sha256",
    "methodology_alignment_path",
    "methodology_alignment_sha256",
    "result_sha256",
    "human_method_approval",
    "human_method_approval_reference"
  ],
  "properties": {
    "analysis_run_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 3
    },
    "run_at": {
      "type": "string",
      "format": "date-time"
    },
    "analysis_method": {
      "type": "string",
      "minLength": 1
    },
    "software": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string"
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "input_artifact_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "script_or_command": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumption_diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "enum": [
        "NOT_REVIEWED",
        "SELF_REVIEWED",
        "INDEPENDENTLY_REPRODUCED",
        "REJECTED"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analysis_specification_path": {
      "type": "string"
    },
    "analysis_specification_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_artifact_path": {
      "type": "string"
    },
    "dataset_path": {
      "type": "string"
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "methodology_alignment_path": {
      "type": "string"
    },
    "methodology_alignment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "human_method_approval": {
      "const": "APPROVED"
    },
    "dataset_artifact_record_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision_register_path": {
      "type": "string"
    },
    "decision_register_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase_ledger_path": {
      "type": "string"
    },
    "phase_ledger_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "human_method_approval_reference": {
      "type": "string",
      "minLength": 1
    },
    "project_manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "project_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reproducibility_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "hash_algorithm",
        "input_hashing",
        "result_serialization",
        "csv_reader",
        "numeric_model",
        "reexecution_claim"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "input_hashing": {
          "type": "string",
          "minLength": 1
        },
        "result_serialization": {
          "type": "string",
          "minLength": 1
        },
        "csv_reader": {
          "type": "string",
          "minLength": 1
        },
        "numeric_model": {
          "type": "string",
          "minLength": 1
        },
        "reexecution_claim": {
          "const": "same-engine deterministic replay; not independent reviewer approval"
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "software": {
            "properties": {
              "version": {
                "const": "0.5.2"
              }
            }
          }
        },
        "required": [
          "software"
        ]
      },
      "then": {
        "required": [
          "project_manifest_path",
          "project_manifest_sha256",
          "reproducibility_contract"
        ],
        "properties": {
          "software": {
            "required": [
              "name",
              "version",
              "python_version",
              "implementation",
              "platform"
            ]
          }
        }
      }
    }
  ]
}
