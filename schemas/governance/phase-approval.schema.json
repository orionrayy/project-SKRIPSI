{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-skripsi/schemas/governance/phase-approval.schema.json",
  "title": "Human Phase Authorization and Acceptance Record",
  "type": "object",
  "required": ["approval_id", "project_id", "phase_id", "decision_type", "decision", "approver_role", "decided_at", "scope", "evidence_refs", "conditions", "recorded_by"],
  "properties": {
    "approval_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 3},
    "phase_id": {"type": "string", "pattern": "^T[0-9]$"},
    "decision_type": {"enum": ["EXECUTION_AUTHORIZATION", "HUMAN_ACCEPTANCE", "INSTITUTIONAL_APPROVAL", "ETHICS_APPROVAL", "DATA_ACCESS_PERMISSION"]},
    "decision": {"enum": ["AUTHORIZE_SCOPED", "ACCEPT", "ACCEPT_WITH_CONDITIONS", "REJECT", "DEFER", "APPROVE", "DENY", "REVOKE"]},
    "approver_role": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "recorded_by": {"type": "string", "minLength": 1},
    "supersedes_approval_id": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "ACCEPT_WITH_CONDITIONS"}}, "required": ["decision"]}, "then": {"properties": {"conditions": {"minItems": 1}}}},
    {"if": {"properties": {"decision": {"const": "AUTHORIZE_SCOPED"}}, "required": ["decision"]}, "then": {"properties": {"scope": {"minLength": 10}}}}
  ],
  "additionalProperties": false
}
