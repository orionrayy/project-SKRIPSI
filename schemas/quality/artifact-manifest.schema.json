{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-skripsi.local/schemas/quality/artifact-manifest.schema.json",
  "title": "Relative Artifact Integrity Manifest",
  "type": "object",
  "required": ["artifacts"],
  "properties": {
    "manifest_version": {"type": "string"},
    "execution_id": {"type": "string"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "bytes", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:/|[A-Za-z]:)"}},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
